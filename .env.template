# ==========================================
# LLM API Configuration
# ==========================================

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic / Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# GLM / Zhipu AI
GLM_API_KEY=your_glm_api_key_here

# Gemini / Google
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter (uses OpenAI-compatible API)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==========================================
# LLM Provider Selection
# ==========================================
# Available: anthropic, openai, glm, gemini, openrouter
# Aliases: claude, gpt, zhipu, google
LLM_PROVIDER=anthropic

# ==========================================
# Model Configuration
# ==========================================
# Default models (can be overridden):
# - anthropic/claude: claude-3-5-sonnet-20241022
# - openai/gpt: gpt-4-turbo
# - glm/zhipu: glm-5-turbo
# - gemini/google: gemini-2.0-flash-exp
# - openrouter: anthropic/claude-3.5-sonnet (or any OpenRouter model)
LLM_MODEL=claude-3-5-sonnet-20241022

# Alternative models examples:
# OPENAI_MODEL=gpt-4-turbo
# GLM_MODEL=glm-5-turbo
# GEMINI_MODEL=gemini-2.0-flash-exp
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ==========================================
# Java Project Settings
# ==========================================
JAVA_PROJECT_PATH=/path/to/your/java/project

# Output directory for generated tests
TEST_OUTPUT_DIR=./tests_generados
