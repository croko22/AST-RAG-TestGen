{
  "manifest_version": 1,
  "project_root": "datasets/reftest-12/commons-cli",
  "dataset": [
    {
      "id": "commons-cli-option",
      "java_file": "src/main/java/org/apache/commons/cli/Option.java"
    }
  ],
  "matrix": {
    "providers": [
      {
        "name": "nvidia",
        "model": "qwen/qwen2.5-coder-32b-instruct"
      }
    ]
  },
  "run": {
    "trials": 1,
    "seed": 42,
    "max_dependencies": 3,
    "timeout_seconds": 120,
    "retry_count": 1,
    "concurrency": 1
  },
  "evaluation": {
    "compile_cmd": "mvn compile test-compile -q",
    "test_cmd": "mvn test -q",
    "run_pit": false
  }
}
